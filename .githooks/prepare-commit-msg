#!/bin/sh
# Remove trailers de atribuicao do Cursor (regra git-commits.mdc).
msgfile="$1"
tmp="${msgfile}.clean"
grep -v -i '^Co-authored-by: Cursor' "$msgfile" \
  | grep -v -i 'cursoragent@cursor.com' \
  | grep -v -i '^Made-with: Cursor' \
  | grep -v -i '^Made with Cursor' > "$tmp" \
  && mv "$tmp" "$msgfile"
exit 0