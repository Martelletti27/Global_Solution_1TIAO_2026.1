# Copie para .env e preencha os valores.
# Obtenha FIRMS_MAP_KEY em: https://firms.modaps.eosdis.nasa.gov/api/map_key/

FIRMS_MAP_KEY=

# 1 = usa dados em data/seed/ (demo sem internet)
# Depois de ativar: python -m src.application.load_seed
OFFLINE_MODE=0

# Ingestao FIRMS (Centro-Oeste): python -m src.infrastructure.firms.ingest

# Grade em graus decimais (0.25 = celulas ~25 km)
GRID_DEG=0.25

# Dias de historico FIRMS na ingestao (API area/csv: maximo 5)
FIRMS_DAYS=5
FIRMS_SOURCE=VIIRS_SNPP_NRT
# Pausa entre requisicoes consecutivas (segundos)
FIRMS_MIN_REQUEST_INTERVAL_SEC=2

# Janela para features e treino
RECENT_DAYS=90

# Banco SQLite (padrao: data/orbitfire.db)
DATABASE_URL=sqlite:///data/orbitfire.db

# API FastAPI (Sprint 5)
API_HOST=127.0.0.1
API_PORT=8000

# Clima Open-Meteo: python -m src.infrastructure.weather.ingest
OPEN_METEO_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_TIMEZONE=America/Sao_Paulo
OPEN_METEO_BATCH_SIZE=25
OPEN_METEO_ARCHIVE_LAG_DAYS=5
