# Copie para .env e preencha os valores.
# Obtenha FIRMS_MAP_KEY em: https://firms.modaps.eosdis.nasa.gov/api/map_key/

FIRMS_MAP_KEY=

# 1 = usa dados em data/seed/ (demo sem internet)
# Depois de ativar: python -m src.application.load_seed
OFFLINE_MODE=0

# Grade em graus decimais (0.25 = celulas ~25 km)
GRID_DEG=0.25

# Dias de historico FIRMS na ingestao
FIRMS_DAYS=7
FIRMS_SOURCE=VIIRS_SNPP_NRT

# Janela para features e treino
RECENT_DAYS=90

# Banco SQLite (padrao: data/orbitfire.db)
DATABASE_URL=sqlite:///data/orbitfire.db

# API FastAPI (Sprint 5)
API_HOST=127.0.0.1
API_PORT=8000
